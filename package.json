{
  "name": "portfolio-v2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "biome check --write .",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@portfolio-v2/env": "*",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@portfolio-v2/config": "*",
    "@types/node": "^26.2.0",
    "rolldown": "1.2.6",
    "typescript": "^6.0.3",
    "vite-plus": "0.3.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "packageManager": "bun@1.3.13"
}
